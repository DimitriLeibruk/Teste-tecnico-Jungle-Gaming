{
  "name": "kurio-nft-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --grep-invert \"Regressão visual\"",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "test:e2e:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lighthouse": "node scripts/lighthouse.mjs",
    "assets": "node scripts/extract-assets.mjs"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "axios": "^1.20.0",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "msw": "^2.15.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
